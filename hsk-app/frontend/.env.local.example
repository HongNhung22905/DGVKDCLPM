# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── JWT Secret (tạo bằng: openssl rand -base64 32) ──────────────────────────
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth (tuỳ chọn) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID="REPLACE_WITH_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# ─── Gia sư AI (dùng ở API routes) ───────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"
# Tuỳ chọn: danh sách model dự phòng, phân cách bởi dấu phẩy
GEMINI_MODELS="gemini-3.6-flash,gemini-3.8-flash,gemini-flash-latest"
AI_DAILY_LIMIT="20"

# ─── AI APIs dùng cho scripts dữ liệu ────────────────────────────────────────
GROQ_API_KEY="gsk_xxxx"
DEEPSEEK_API_KEY="sk-xxxx"
