# Không cần key để chạy test hoặc nhập XML. Khởi động lại công cụ sau khi đổi .env.
PORT=4317
# Chỉ dùng key riêng cho công cụ, không đọc .env của website HSK.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Để trống: ưu tiên .venv của công cụ, sau đó python trong PATH.
# Có thể đặt đường dẫn tuyệt đối tới python.exe trong môi trường có pytest, selenium.
PYTHON_EXECUTABLE=
