# Chỉ dùng cho HSK kiểm thử. Không sao chép DATABASE_URL của website hiện tại.
HSK_TEST_BRANCH=hsk-test-2026-10-19
# Copy hostname compute của BRANCH MỚI trong Neon, không gồm postgresql:// hoặc mật khẩu.
HSK_TEST_DATABASE_HOST=
# Dán chuỗi PostgreSQL của BRANCH MỚI tại đây, giữ nguyên tham số SSL Neon cấp.
DATABASE_URL=
# Để trống để sinh secret xác thực riêng mỗi lần mở môi trường kiểm thử.
NEXTAUTH_SECRET=
